# Optional: build web with Vite+ CLI installed via official script (see plan).
# Default project build uses Node + Vite from package.json in the root Dockerfile.
#
# Example:
#   docker build -f docker/Dockerfile.web -t dnstube-web .
#
# FROM node:22-bookworm-slim
# RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates bash \
#   && rm -rf /var/lib/apt/lists/*
# RUN curl -fsSL https://vite.plus | bash
# WORKDIR /app
# COPY web/package.json web/package-lock.json ./
# RUN npm ci
# COPY web/ ./
# RUN vp build
# The resulting `dist/` can be copied into `cmd/dnstube/web/dist` before `go build`.
