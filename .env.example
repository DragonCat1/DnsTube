# PostgreSQL connection URL (required)
DATABASE_URL=postgres://dnstube:dnstube@127.0.0.1:5432/dnstube?sslmode=disable

# JWT signing secret for admin API (required)
JWT_SECRET=change-me-to-a-long-random-string

# HTTP listen address for management API and static UI (default :8080)
HTTP_ADDR=:8080

# Graceful shutdown timeout in seconds (optional)
# SHUTDOWN_TIMEOUT_SEC=15

# DNS upstream exchange timeout in milliseconds (optional, default 2000)
# 同时作用于 UDP / DoT / DoH 单次 exchange（DoH 还会作为 HTTP 客户端 Timeout 与
# response header 超时的兜底）。
# DNS_UDP_UPSTREAM_TIMEOUT_MS=2000

# DNS UDP max concurrent query handlers per listener (optional, default 256)
# DNS_UDP_MAX_CONCURRENT_QUERIES=256
